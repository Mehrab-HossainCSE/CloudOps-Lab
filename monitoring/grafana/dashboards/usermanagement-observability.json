    {
      "id": 19,
      "title": "Scrape Target Health",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 38, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
